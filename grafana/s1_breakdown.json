  {
   "id": 13,
   "type": "table",
   "title": "Work orders (all vehicles, latest first)",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "quantara-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 14,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "quantara-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT to_timestamp(ts) AS time, vehicle_id AS vehicle, payload->>'final_cause' AS fault_to_fix, CASE payload->>'final_cause' WHEN 'pump_fault' THEN 'Replace coolant pump, bleed system' WHEN 'cell_heating' THEN 'Inspect module for hotspot, isolate pack' WHEN 'sensor_fault' THEN 'Replace temperature sensor' WHEN 'high_load' THEN 'No repair. Advise driver' ELSE 'Diagnose' END AS work_order, payload->'twin'->'time_to_derate_s'->>'1.0' AS s_to_derate_at_full_power, payload->>'hidden_heat_confirmed' AS hidden_heat FROM events WHERE topic='cloud.twin' AND payload->>'security'='false' AND ts BETWEEN $__unixEpochFrom() AND $__unixEpochTo() ORDER BY id DESC LIMIT 25",
     "refId": "A"
    }
   ]
  },
  {
   "id": 14,
   "type": "barchart",
   "title": "Why? Cause ranking for this vehicle's latest incident",
   "description": "Posterior probability per candidate cause (likelihood x learned prior)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "quantara-pg"
   },
   "gridPos": {
    "x": 14,
    "y": 21,
    "w": 10,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "legend": {
     "showLegend": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "quantara-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT h->>'cause' AS cause, (h->>'posterior')::float AS posterior FROM (SELECT payload FROM events WHERE topic='cloud.rca' AND payload->>'kind'='rca' AND vehicle_id='${vehicle}' ORDER BY id DESC LIMIT 1) e, jsonb_array_elements(e.payload->'hypotheses') h",
     "refId": "A"
    }
   ]
  },
