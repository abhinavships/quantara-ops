  {
   "id": 17,
   "type": "table",
   "title": "Cloud AI second opinion (Gemini) vs rule/Bayes verdict",
   "description": "Shown when the Bayesian cause ranking is unsure. The AI may only pick a known cause and can never issue a command.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "quantara-pg"
   },
   "gridPos": {
    "x": 14,
    "y": 31,
