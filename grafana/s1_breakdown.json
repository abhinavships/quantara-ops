  {
   "id": 11,
   "type": "table",
   "title": "Message shown to the driver (from the cloud verdict)",
   "description": "Plain-language message derived from the cloud's final cause",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "quantara-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "quantara-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT to_timestamp(ts) AS time, vehicle_id AS vehicle, CASE payload->>'final_cause' WHEN 'pump_fault' THEN 'Cooling pump is failing. Power is reduced to protect the battery. Please drive to a service centre.' WHEN 'cell_heating' THEN 'Battery is heating abnormally. Reduced power. Stop safely if the warning stays on.' WHEN 'high_load' THEN 'Hard driving in heat. No fault. Ease off the throttle.' WHEN 'sensor_fault' THEN 'A temperature sensor is faulty. Car is ignoring it. Service when convenient.' ELSE 'Check needed. Reduced power as a precaution.' END AS message_to_driver, payload->>'recommended_cap' AS power_cap FROM events WHERE topic='cloud.twin' AND payload->>'security'='false' AND vehicle_id='${vehicle}' AND ts BETWEEN $__unixEpochFrom() AND $__unixEpochTo() ORDER BY id DESC LIMIT 5",
     "refId": "A"
    }
   ]
  },
