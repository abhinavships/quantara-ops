     "rawQuery": true,
     "rawSql": "SELECT k AS vehicle, (payload->'vss'->>'Vehicle.Powertrain.TractionBattery.Efficiency')::float AS km_per_kwh, round(((payload->'vss'->>'Vehicle.Powertrain.TractionBattery.StateOfCharge.Current')::float*60*(payload->'vss'->>'Vehicle.Powertrain.TractionBattery.Efficiency')::float)::numeric,0) AS est_range_km, (payload->'vss'->>'Vehicle.Powertrain.TractionBattery.StateOfCharge.Current')::float AS soc FROM latest WHERE k LIKE 'vss:V%' ORDER BY 2 ASC LIMIT 15",
     "refId": "A"
