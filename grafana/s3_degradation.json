    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "quantara-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT to_timestamp(ts) AS time, vehicle_id AS vehicle, payload->>'edge_cause' AS edge_said, payload->>'final_cause' AS cloud_verdict, payload->>'rca_top' AS ranked_top, payload->>'hidden_heat_confirmed' AS hidden_heat, payload->>'recommended_cap' AS power_cap, payload->'twin'->'time_to_derate_s'->>'1.0' AS s_to_derate_full_power FROM events WHERE topic='cloud.twin' AND payload->>'final_cause'='efficiency_degradation' AND ts BETWEEN $__unixEpochFrom() AND $__unixEpochTo() ORDER BY id DESC LIMIT 25",
     "refId": "A"
    }
   ]
  },
