     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT date_trunc('minute', to_timestamp(ts)) AS time, avg((vss->>'Vehicle.Powertrain.TractionBattery.Efficiency')::float) AS fleet_avg FROM telemetry WHERE vehicle_id LIKE 'V%' AND ts BETWEEN $__unixEpochFrom() AND $__unixEpochTo() GROUP BY 1 ORDER BY 1",
     "refId": "A"
    }
   ]
