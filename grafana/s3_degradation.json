     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT to_timestamp(ts) AS time, vehicle_id AS vehicle, payload->>'top' AS bayes_top, payload->'llm'->>'cause' AS ai_cause, payload->'llm'->>'confidence' AS ai_conf, payload->'llm'->>'model' AS model, payload->'llm'->>'rationale' AS ai_rationale FROM events WHERE topic='cloud.rca' AND payload->'llm'->>'cause' IS NOT NULL AND ts BETWEEN $__unixEpochFrom() AND $__unixEpochTo() ORDER BY id DESC LIMIT 20",
