     "rawQuery": true,
     "rawSql": "SELECT to_timestamp(ts) AS time, (vss->>'Vehicle.Powertrain.TractionBattery.Efficiency')::float AS \"km/kWh\" FROM telemetry WHERE vehicle_id='${vehicle}' AND ts BETWEEN $__unixEpochFrom() AND $__unixEpochTo() ORDER BY ts",
